{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wireguard-gui",
  "version": "0.3.0",
  "identifier": "com.dohokun.wireguard-gui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WireGuard 控制台",
        "width": 1080,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "WireGuard 桌面管理工具",
    "longDescription": "基于 Tauri 的 WireGuard 桌面管理 GUI：接口状态监控、Peer 管理、配置读写与导入导出。特权操作经 pkexec（polkit）桥接，密钥只走 stdin。",
    "publisher": "DHKun <DHKun@users.noreply.github.com>",
    "homepage": "https://github.com/DHKun/Wireguard-GUI",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "postInstallScript": "scripts/refresh-desktop-cache.sh",
        "postRemoveScript": "scripts/refresh-desktop-cache.sh"
      },
      "rpm": {
        "postInstallScript": "scripts/refresh-desktop-cache.sh",
        "postRemoveScript": "scripts/refresh-desktop-cache.sh"
      }
    }
  }
}
